<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nut.Results" Version="2.1.1" />
    <PackageReference Include="OpenAI" Version="2.2.0-beta.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical master vocabularies shared by Shuffull and the producer.
         LogicalName keeps the manifest name stable regardless of root namespace/folder. -->
    <EmbeddedResource Include="Resources/genres.json" LogicalName="genres.json" />
    <EmbeddedResource Include="Resources/moods.json" LogicalName="moods.json" />
    <EmbeddedResource Include="Resources/themes.json" LogicalName="themes.json" />
  </ItemGroup>

</Project>
